rules_version = '2';
// users/{auth UID}: client bootstrap has email (1..254), createdAt, updatedAt.
// Express adds profile/preferences/medical fields via Admin SDK. Owners can read
// these fields but all subsequent modifications must go through the API.
// programs, reservations, facilities and subcollections: API-only access.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['email', 'createdAt', 'updatedAt'])
        && data.email is string && data.email.size() > 0 && data.email.size() <= 254
        && data.email == request.auth.token.email
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.createdAt == request.time && data.updatedAt == request.time;
    }
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidUser(request.resource.data);
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
